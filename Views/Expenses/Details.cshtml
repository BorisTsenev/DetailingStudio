@model DetailingStudio.Data.Models.Expense

@{
    ViewData["Title"] = "Expense Details";
}

<div class="page-heading"><div><p class="eyebrow">Studio management / Expenses</p><h1>Expense Details</h1><p class="page-description">Keep your studio spending clear and organised.</p></div></div>

<section class="record-panel">
<div class="mb-4">

    <p>
        <strong>Description:</strong>
        @Model.Description
    </p>

    <p>
        <strong>Amount:</strong>
        @Model.Amount.ToString("F2") €
    </p>

    <p>
        <strong>Category:</strong>
        @Model.ExpenseCategory.Name
    </p>

    <p>
        <strong>Expense Date:</strong>
        @Model.ExpenseDate.ToString("dd.MM.yyyy")
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <p>
            <strong>Notes:</strong>
            @Model.Notes
        </p>
    }

    <p>
        <strong>Created:</strong>
        @Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")
    </p>

</div>

</section>
<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Edit
</a>