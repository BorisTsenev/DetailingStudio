@model DetailingStudio.Data.Models.Expense

@{
    ViewData["Title"] = "Delete Expense";
}

<div class="page-heading"><div><p class="eyebrow">Studio management / Expenses</p><h1>Delete Expense</h1><p class="page-description">Keep your studio spending clear and organised.</p></div></div>

<section class="record-panel">
<div class="alert alert-warning">
    Are you sure you want to delete this expense?
</div>

<div class="mb-4">

    <p>
        <strong>Description:</strong>
        @Model.Description
    </p>

    <p>
        <strong>Amount:</strong>
        @Model.Amount.ToString("F2") €
    </p>

    <p>
        <strong>Category:</strong>
        @Model.ExpenseCategory.Name
    </p>

    <p>
        <strong>Date:</strong>
        @Model.ExpenseDate.ToString("dd.MM.yyyy")
    </p>

</div>

</section>
<form class="studio-form" asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>