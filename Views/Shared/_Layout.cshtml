<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - DetailingStudio</title>
	<script src="~/js/theme.js" asp-append-version="true"></script>
	<script type="importmap"></script>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/DetailingStudio.styles.css" asp-append-version="true" />
</head>
<body>
	<a class="skip-link" href="#main-content">Skip to content</a><header class="app-header">
		<nav class="navbar navbar-expand-xl">
			<div class="container-fluid app-nav">
				<a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark" aria-hidden="true">DS</span>Detailing<span class="brand-light">Studio</span></a>
				<div class="d-flex align-items-center gap-2 order-xl-last"><button id="themeToggle" class="theme-toggle" type="button" aria-label="Switch color theme"><span aria-hidden="true">&#9680;</span><span class="theme-label">Theme</span></button><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button></div>
				<div class="navbar-collapse collapse justify-content-between" id="navbarSupportedContent">
					<ul class="navbar-nav flex-grow-1">
						<li class="nav-item">
							<a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "page" : null)" asp-area="" asp-controller="Dashboard" asp-action="Index">Dashboard</a>
						</li>
						
						<li class="nav-item">
							<a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "page" : null)" asp-area="" asp-controller="Customers" asp-action="Index">Customers</a>
						</li>
						<li class="nav-item">
							<a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vehicles" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Vehicles" ? "page" : null)" asp-area="" asp-controller="Vehicles" asp-action="Index">Vehicles</a>
						</li>

						<li class="nav-item">
							<a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Services" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Services" ? "page" : null)" asp-area="" asp-controller="Services" asp-action="Index">Services</a>

						</li>
						<li class="nav-item">
							<a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DetailingOrders" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "DetailingOrders" ? "page" : null)" asp-area="" asp-controller="DetailingOrders" asp-action="Index">Orders</a>
						</li>

						<li class="nav-item">
							<a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Expenses" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Expenses" ? "page" : null)" asp-area="" asp-controller="Expenses" asp-action="Index">Expenses</a>
						</li>

						<li class="nav-item">
							<a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" aria-current="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "page" : null)" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
						</li>
					</ul>
					<partial name="_LoginPartial" />
				</div>
			</div>
		</nav>
	</header>
	<div class="container-fluid app-shell">
		<main role="main" id="main-content" class="page-content" tabindex="-1">
			@RenderBody()
		</main>
	</div>

	<footer class="app-footer">
		<div class="container-fluid app-shell">
			&copy; 2026 DetailingStudio <span class="footer-divider">/</span> Studio management &middot; <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
