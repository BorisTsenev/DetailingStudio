@model IEnumerable<DetailingStudio.Data.Models.Customer>
@using DetailingStudio.Data.Models

@{
    ViewData["Title"] = "Customers";
}

<div class="page-heading"><div><p class="eyebrow">Studio management / Customers</p><h1>Customers</h1><p class="page-description">Customer relationships and contact information.</p></div></div>
<a asp-controller="Customers" asp-action="Create" class="btn btn-primary">Add Customer</a>

<div class="table-responsive table-panel"><table class="table table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Customer customer in Model)
        {
            <tr>
                <td>@customer.FirstName</td>
                <td>@customer.LastName</td>
                <td>@customer.PhoneNumber</td>
                <td>@customer.Email</td>
                <td>
                    <a asp-controller="Customers"
                       asp-action="Details"
                       asp-route-id="@customer.Id"
                       class="btn btn-info">
                        Details
                    </a>
                    <a asp-controller="Customers"
                       asp-action="Edit"
                       asp-route-id="@customer.Id"
                       class="btn btn-warning">
                        Edit
                    </a>
                    <a asp-controller="Customers"
                       asp-action="Delete"
                       asp-route-id="@customer.Id"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table></div>