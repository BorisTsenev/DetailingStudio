@model DetailingStudio.Data.Models.Customer

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="page-heading"><div><p class="eyebrow">Studio management / Customers</p><h1>Delete Customer</h1><p class="page-description">Customer relationships and contact information.</p></div></div>

<section class="record-panel">
<div class="alert alert-danger" role="alert"><strong>Confirm deletion</strong><p class="mb-0">Are you sure you want to delete this customer?</p></div>

<div class="mb-3">
    <p><strong>First Name:</strong> @Model.FirstName</p>
    <p><strong>Last Name:</strong> @Model.LastName</p>
    <p><strong>Phone:</strong> @Model.PhoneNumber</p>
    <p><strong>Email:</strong> @Model.Email</p>
</div>

</section>
<form class="studio-form" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>