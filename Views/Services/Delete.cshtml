@model DetailingStudio.Data.Models.Service
@using DetailingStudio.Data.Models


@{
    ViewData["Title"] = "Delete Service";
}

<div class="page-heading"><div><p class="eyebrow">Studio management / Services</p><h1>Delete Service</h1><p class="page-description">Your service catalogue and vehicle-category pricing.</p></div></div>

<section class="record-panel">
<div class="alert alert-danger" role="alert"><strong>Confirm deletion</strong><p class="mb-0">Are you sure you want to delete this service?</p></div>

<div class="mb-4">

    <p>
        <strong>Service Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Description:</strong>
        @Model.Description
    </p>

    <p>
        <strong>Status:</strong>
        @(Model.IsActive ? "Active" : "Inactive")
    </p>

    <h4>Prices by Vehicle Category</h4>

    <div class="table-responsive table-panel"><table class="table table-bordered">
        <thead>
            <tr>
                <th>Category</th>
                <th>Price</th>
            </tr>
        </thead>

        <tbody>
            @foreach (ServicePrice price in Model.ServicePrices)
            {
                <tr>
                    <td>
                        <span class="badge bg-secondary">
                            @price.VehicleCategory.Name
                        </span>
                    </td>

                    <td>
                        @price.Price.ToString("F2") €
                    </td>
                </tr>
            }
        </tbody>
    </table></div>

</div>

</section>
<form class="studio-form" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
