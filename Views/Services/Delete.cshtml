@model DetailingStudio.Data.Models.Service
@using DetailingStudio.Data.Models


@{
    ViewData["Title"] = "Delete Vehicle";
}

<h1>Delete Vehicle</h1>

<p>Are you sure you want to delete this vehicle?</p>

<div class="mb-4">

    <p>
        <strong>Service Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Description:</strong>
        @Model.Description
    </p>

    <p>
        <strong>Status:</strong>
        @(Model.IsActive ? "Active" : "Inactive")
    </p>

    <h4>Prices by Vehicle Category</h4>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Category</th>
                <th>Price</th>
            </tr>
        </thead>

        <tbody>
            @foreach (ServicePrice price in Model.ServicePrices)
            {
                <tr>
                    <td>
                        <span class="badge bg-secondary">
                            @price.VehicleCategory.Name
                        </span>
                    </td>

                    <td>
                        @price.Price.ToString("F2") €
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
