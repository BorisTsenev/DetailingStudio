@using DetailingStudio.Data.Models
@model DetailingStudio.Data.Models.Service

@{
    ViewData["Title"] = "Service Details";
}

<h1>Service Details</h1>

<div class="mb-4">

    <p>
        <strong>Service Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Description:</strong>
        @Model.Description
    </p>

    <p>
        <strong>Status:</strong>
        @(Model.IsActive ? "Active" : "Inactive")
    </p>

    <h4>Prices by Vehicle Category</h4>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Category</th>
                <th>Price</th>
            </tr>
        </thead>

        <tbody>
            @foreach (ServicePrice price in Model.ServicePrices)
            {
                <tr>
                    <td>
                        <span class="badge bg-secondary">
                            @price.VehicleCategory.Name
                        </span>
                    </td>

                    <td>
                        @price.Price.ToString("F2") €
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>

<a asp-controller="Services"
   asp-action="Index"
   class="btn btn-secondary">
    Back
</a>

<a asp-controller="Services"
   asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Edit
</a>