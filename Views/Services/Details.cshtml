@using DetailingStudio.Data.Models
@model DetailingStudio.Data.Models.Service

@{
    ViewData["Title"] = "Service Details";
}

<div class="page-heading"><div><p class="eyebrow">Studio management / Services</p><h1>Service Details</h1><p class="page-description">Your service catalogue and vehicle-category pricing.</p></div></div>

<section class="record-panel">
<div class="mb-4">

    <p>
        <strong>Service Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Description:</strong>
        @Model.Description
    </p>

    <p>
        <strong>Status:</strong>
        @(Model.IsActive ? "Active" : "Inactive")
    </p>

    <h4>Prices by Vehicle Category</h4>

    <div class="table-responsive table-panel"><table class="table table-bordered">
        <thead>
            <tr>
                <th>Category</th>
                <th>Price</th>
            </tr>
        </thead>

        <tbody>
            @foreach (ServicePrice price in Model.ServicePrices)
            {
                <tr>
                    <td>
                        <span class="badge bg-secondary">
                            @price.VehicleCategory.Name
                        </span>
                    </td>

                    <td>
                        @price.Price.ToString("F2") €
                    </td>
                </tr>
            }
        </tbody>
    </table></div>

</div>

</section>
<a asp-controller="Services"
   asp-action="Index"
   class="btn btn-secondary">
    Back
</a>

<a asp-controller="Services"
   asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Edit
</a>