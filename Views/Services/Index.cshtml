@model IEnumerable<DetailingStudio.Data.Models.Service>
@using DetailingStudio.Data.Models

@{
    ViewData["Title"] = "Services";
}

<h1>Services</h1>

<a asp-controller="Services"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Add Service
</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Prices</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Service service in Model)
        {
            <tr>
                <td>@service.Name</td>

                <td>@service.Description</td>

                <td>
                    @foreach (ServicePrice price in service.ServicePrices)
                    {
                        <div>
                            <strong>@price.VehicleCategory.Name:</strong>
                            @price.Price.ToString("F2")
                        </div>
                    }
                </td>

                <td>
                    @(service.IsActive ? "Active" : "Inactive")
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@service.Id"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@service.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@service.Id"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
