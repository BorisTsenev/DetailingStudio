@model IEnumerable<DetailingStudio.Data.Models.Service>
@using DetailingStudio.Data.Models

@{
    ViewData["Title"] = "Services";
}

<div class="page-heading"><div><p class="eyebrow">Studio management / Services</p><h1>Services</h1><p class="page-description">Your service catalogue and vehicle-category pricing.</p></div></div>

<a asp-controller="Services"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Add Service
</a>

<form asp-action="Index"
      method="get"
      class="mb-3">

    <div class="row">
        <div class="col-md-4">

            <label class="form-label">
                Filter by vehicle category
            </label>

            <select name="categoryId"
                    asp-items="ViewBag.Categories"
                    class="form-select">

                <option value="">All Categories</option>

            </select>

        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit"
                    class="btn btn-primary">
                Filter
            </button>
        </div>
    </div>
</form>

<div class="table-responsive table-panel"><table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Category</th>
            <th>Prices</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (Service service in Model)
        {
            <tr>
                <td><strong>@service.Name</strong><br /><span class="service-type" data-type="@service.ServiceType">@service.ServiceType</span></td>

                <td>@service.Description</td>

                <td>
                    @foreach (ServicePrice price in service.ServicePrices)
                    {
                        <span class="badge bg-secondary">
                            @price.VehicleCategory.Name
                        </span>
                    }
                </td>

                <td>
                    @foreach (ServicePrice price in service.ServicePrices)
                    {
                        <div>
                            <strong>@price.VehicleCategory.Name:</strong>
                            @price.Price.ToString("F2")
                        </div>
                    }
                </td>

                <td>
                    @(service.IsActive ? "Active" : "Inactive")
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@service.Id"
                       class="btn btn-info">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@service.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@service.Id"
                       class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table></div>
