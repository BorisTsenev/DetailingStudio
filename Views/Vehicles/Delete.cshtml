@model DetailingStudio.Data.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<h1>Delete Vehicle</h1>

<p>Are you sure you want to delete this vehicle?</p>

<div class="mb-3">
	<p><strong>Make:</strong> @Model.Make</p>
    <p><strong>Model:</strong> @Model.Model</p>
    <p><strong>Registration Number:</strong> @Model.RegistrationNumber</p>
    <p><strong>VIN Number:</strong> @Model.VinNumber</p>
    <p><strong>Year:</strong> @Model.Year</p>
	<p><strong>Color:</strong> @Model.Color</p>
	<p><strong>Vehicle Category:</strong> @Model.VehicleCategory.Name</p>
	<p><strong>Owner:</strong> @Model.Customer.FirstName @Model.Customer.LastName @Model.Customer.PhoneNumber</p>

</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>
