@model DetailingStudio.Data.Models.Vehicle

@{
    ViewData["Title"] = "Add Vehicle";
}

<h1>Add Vehicle</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Make" class="form-label"></label>
        <input asp-for="Make" class="form-control" />
        <span asp-validation-for="Make" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RegistrationNumber" class="form-label"></label>
        <input asp-for="RegistrationNumber" class="form-control" />
        <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="VinNumber" class="form-label"></label>
        <input asp-for="VinNumber" class="form-control" />
        <span asp-validation-for="VinNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Year" class="form-label"></label>
        <input asp-for="Year" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Color" class="form-label"></label>
        <input asp-for="Color" class="form-control" />
        <span asp-validation-for="Color" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label">Owner</label>

        <select asp-for="CustomerId"
                asp-items="ViewBag.Customers"
                class="form-select">
            <option value="">-- Select Owner --</option>
        </select>

        <span asp-validation-for="CustomerId"
              class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="VehicleCategoryId"
               class="form-label">
            Category
        </label>

        <select asp-for="VehicleCategoryId"
                asp-items="ViewBag.VehicleCategories"
                class="form-select">
            <option value="">-- Select Category --</option>
        </select>

        <span asp-validation-for="VehicleCategoryId"
              class="text-danger"></span>
    </div>



    <button type="submit" class="btn btn-primary">
        Add Vehicle
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}